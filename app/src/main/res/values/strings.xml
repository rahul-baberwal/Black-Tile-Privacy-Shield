    <!-- Help & Instructions -->
    <string name="help_title">How to Use</string>
    <string name="help_text" formatted="false">1. Edit Mode: Drag anywhere on a tile to move. Drag the bottom-right corner to resize. Tap ✕ to delete.\n2. Lock Mode: Hides borders and handles, allowing all touch events to pass directly through.\n3. Opacity: Tune shade opacity between 20% and 100% in Settings.\n4. Quick Settings: Use the Quick Settings tile in your notification drawer.\n5. Widget: Add the 3-button widget to your home screen.</string>

